menu "Zephyr"
source "Kconfig.zephyr"
endmenu

config KENNING_PROTOCOL_INTEGRATION
    bool "Max sum of channels in available sensors"
    default n
    depends on PROVIDER_LIB && ANOMALY_LIB && KENNING_COMMUNICATION_PROTOCOL_UART && KENNING_INFERENCE_LIB

config PROCESSING_DELAY
    int "Expected time [ms] of processing for a single model sample"
    default 50
    depends on PROVIDER_LIB && ANOMALY_LIB

config CLASSIFIER_USE_EXP_MOVING_AVERAGES
    bool "Use exponential moving averages for smoothing values"
    default n
    depends on ANOMALY_LIB

config CLASSIFIER_EXP_MOVING_AVERAGES_SMOOTHING_PERCENT
    int "alpha smoothing factor for exponential smoothing"
    default 30
    depends on CLASSIFIER_USE_EXP_MOVING_AVERAGES

config MAX_ANOMALY_COUNT
    int "The maximum number of anomalies to be detected before exit during test (default 0 means unlimited)"
    default 0



module = APP
module-str = app
source "subsys/logging/Kconfig.template.log_config"
